{
  "name": "playwright-framework",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end test automation framework built with Playwright and TypeScript",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:smoke": "playwright test --grep @smoke",
    "test:grep": "playwright test --grep",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "validate": "yarn lint && yarn typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.1",
    "eslint-plugin-jsonc": "^3.2.0",
    "eslint-plugin-playwright": "^2.10.4",
    "globals": "^17.0.0",
    "jsonc-eslint-parser": "^3.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  }
}
